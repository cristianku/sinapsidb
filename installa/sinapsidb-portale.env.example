# /etc/sinapsidb/portale.env: configurazione di sinapsidb-portale installato come servizio di sistema
# (vedi docs/installare.md). Nessun segreto qui. Dopo una modifica: systemctl restart sinapsidb-portale
# Una variabile presente ma vuota vale come assente.
#
# Il portale non ha autenticazione propria: mostra a chiunque lo raggiunga i tempi di risposta, gli IP
# dei client e i dati memorizzati. I valori qui sotto lo tengono su localhost. Per raggiungerlo da un'altra
# macchina mettilo dietro un proxy con autenticazione e aggiungi qui l'IP del proxy e il nome pubblico.

SINAPSIDB_PORTALE_BIND=127.0.0.1
SINAPSIDB_PORTALE_PORT=8419

# IP sorgente ammessi. Tutti gli altri ricevono 403. Il controllo usa l'indirizzo del socket,
# non X-Forwarded-For: dietro un proxy qui va l'IP del proxy.
SINAPSIDB_PORTALE_ALLOWED_CLIENTS=127.0.0.1,::1

# Nomi ammessi nell'header Host, senza porta. Gli altri ricevono 421. Dietro un nome pubblico
# va aggiunto quel nome.
SINAPSIDB_PORTALE_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Sonda sintetica per un server MCP di SinapsiDB, che non fa parte di questa uscita: resta spenta.
SINAPSIDB_SONDA_INTERVALLO=0

SINAPSIDB_PORTALE_LOG_LEVEL=info

# Confronto con PostgreSQL (pagina /confronto). Il portale si collega dal socket locale come utente
# del servizio, con l'autenticazione peer: nessuna password. Il suo ruolo possiede la sola base di
# dati di prova: ci scrive quando genera l'azienda di prova, per il resto si collega in sola lettura.
# La rete di prova sta in una cartella a parte: se non è indicata è /var/lib/sinapsidb/prova.
SINAPSIDB_PROVA_PG=dbname=sinapsidb_prova
# SINAPSIDB_PROVA_DIR=/var/lib/sinapsidb/prova
# Le taglie dell'azienda di prova che la pagina lascia generare, in record totali. Di serie arrivano
# al milione, che sta nel MemoryMax=1200M dell'unità. Ogni milione di record costa al portale circa
# 430 MB di memoria a riposo e 800 MB durante importazione e confronto: per offrire taglie più grandi
# va alzato anche il tetto dell'unità (MemoryMax, vedi docs/installare.md).
# SINAPSIDB_PROVA_TAGLIE=100000,300000,500000,1000000
# La taglia da dieci milioni chiede un tetto di circa 10G per il portale:
# SINAPSIDB_PROVA_TAGLIE=100000,300000,500000,1000000,10000000

# Redis nel confronto (pagina /confronto): il portale gli prepara le risposte delle quindici domande leggendo
# PostgreSQL, e poi fa le stesse domande anche a lui. Scrive e cancella solo le chiavi che cominciano con
# sinapsidb:prova: e non usa password. Senza questa riga il confronto si fa solo con PostgreSQL.
# Dal socket locale, la scelta equa perché anche PostgreSQL è raggiunto dal socket:
# SINAPSIDB_PROVA_REDIS=unix:///run/redis/redis-server.sock
# Dalla porta locale, se il socket non si può usare. La pagina lo dichiara nelle note dei risultati:
# SINAPSIDB_PROVA_REDIS=redis://127.0.0.1:6379/0
# Le risposte pronte occupano in Redis circa 95 byte per ogni record dell'azienda di prova: 90 MB per un milione,
# 900 MB per dieci milioni. Se il suo tetto (maxmemory) non basta, la pagina lo dice.

# La rete di prova sul disco (pulsante «Tieni in memoria solo quello che serve» della pagina /confronto): quanta rete
# può stare in memoria, in MB. Di serie 256. È memoria del portale: deve stare nel MemoryMax dell'unità.
# SINAPSIDB_PROVA_TETTO_BLOCCHI_MB=256

# Pagina delle decisioni (/decisioni): una memoria di prova tutta sua, con il fido dei clienti. Se non è
# indicata sta in /var/lib/sinapsidb/decisioni. Non è la memoria vera e non è la rete di prova del confronto.
# SINAPSIDB_DECISIONI_DIR=/var/lib/sinapsidb/decisioni

# Il file delle metriche è impostato nell'unità: /var/lib/sinapsidb/metriche.db
