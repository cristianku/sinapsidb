# Unità systemd per sinapsidb-portale (portale di SinapsiDB: decisioni, dati e confronto con PostgreSQL e Redis).
# Installazione: vedi docs/installare.md. Gira come utente di sistema `sinapsidb` e tiene i suoi dati in
# /var/lib/sinapsidb (il file delle metriche, la memoria delle decisioni e la rete di prova).
# Per il confronto tiene la rete di prova in /var/lib/sinapsidb/prova e parla con PostgreSQL dal socket
# locale, come ruolo `sinapsidb`: ci scrive solo quando genera l'azienda di prova, per il resto legge.
# Se SINAPSIDB_PROVA_REDIS è impostata parla anche con Redis, dal socket o dalla porta locale, e ci tocca
# solo le chiavi del confronto.
# Parte anche se PostgreSQL o Redis sono fermi, così il portale lo può mostrare.

[Unit]
Description=sinapsidb-portale (portale di SinapsiDB: decisioni, dati e confronto)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=SINAPSIDB_METRICHE_DB=/var/lib/sinapsidb/metriche.db
Environment=PYTHONDONTWRITEBYTECODE=1
# I valori di portale.env hanno la precedenza su quelli qui sopra. Senza il file valgono i predefiniti.
EnvironmentFile=-/etc/sinapsidb/portale.env
ExecStart=/opt/sinapsidb/.venv/bin/sinapsidb-portale
Restart=on-failure
RestartSec=5s
# Il portale può condividere la macchina con PostgreSQL e Redis: se superasse questo tetto, systemd
# ferma e rilancia solo il portale. La rete di prova del confronto sta in memoria: con un milione di
# record, la taglia più grande che il portale offre di serie, il portale misurato usa 430 MB a riposo
# e 800 MB di picco. Taglie più grandi chiedono un tetto più alto e SINAPSIDB_PROVA_TAGLIE:
# vedi docs/installare.md.
MemoryMax=1200M

User=sinapsidb
Group=sinapsidb
StateDirectory=sinapsidb
StateDirectoryMode=0750
WorkingDirectory=/opt/sinapsidb
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
